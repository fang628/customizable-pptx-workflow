{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "canvas",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "unit",
        "aspect"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "unit": {
          "const": "px"
        },
        "aspect": {
          "const": "16:9"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "images"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "background": {
            "type": "string",
            "minLength": 1
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/image"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "normalizedBox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "pixelBox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "description",
        "path",
        "box",
        "pixelBox",
        "fit",
        "z",
        "altText",
        "reason",
        "placeholder"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "box": {
          "$ref": "#/$defs/normalizedBox"
        },
        "pixelBox": {
          "$ref": "#/$defs/pixelBox"
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "focal": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "crop": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "z": {
          "type": "integer"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "object",
          "required": [
            "color",
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "boundaryMask": {
          "$ref": "#/$defs/boundaryMask"
        }
      }
    },
    "boundaryMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "boundary",
        "reason",
        "protectsContent"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "protectsContent": {
          "const": true,
          "description": "逐页看图确认主体与关键信息完整；该声明不代替实际检查。"
        }
      },
      "description": "图片显示边缘的闭合轮廓；相对图片框的归一化点，可沿圆弧或曲线采样。原件与比例保持不变。"
    }
  }
}
