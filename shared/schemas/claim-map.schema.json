{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "slides"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claims"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{2,}$" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "sourceIds", "evidence", "elementIds"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "pages": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
                "evidence": { "type": "string", "minLength": 1 },
                "elementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "imageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
