{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "stages"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "stages": {
      "type": "object",
      "required": [
        "0",
        "1.1",
        "1.2",
        "1.3",
        "2.1",
        "2.2",
        "3.1",
        "3.2",
        "3.3",
        "4"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "awaiting_user",
              "complete",
              "blocked"
            ]
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "dependencies": {
            "type": "object",
            "required": [
              "version",
              "shared",
              "pages"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "shared": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pages": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "additionalProperties": false
          },
          "pending_pages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2,}$"
            }
          },
          "global_change": {
            "type": "boolean"
          },
          "active_step": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
