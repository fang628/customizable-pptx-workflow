{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "特殊分块参考图清单（阶段 2.1／2.2）",
  "type": "object",
  "required": [
    "version",
    "pages"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 1
    },
    "generatedFrom": {
      "type": "string"
    },
    "skillIndex": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "references"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "splits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
